# Local Overrides (gitignored)
# Copy to .env.local and customize for your local machine
# This file is gitignored - safe for local customization

# Override with your local MongoDB if not using Atlas
# DATABASE_URL=mongodb://localhost:27017/manufacturing_dev

# Your local LAN IP for mobile testing
# CORS_ORIGINS=http://localhost:8081,http://192.168.1.XXX:8081,exp://192.168.1.XXX:8081

# Relaxed rate limiting for local dev
# RATE_LIMIT_MAX_REQUESTS=10000