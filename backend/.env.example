# Backend Environment Configuration
# Copy the appropriate file to .env based on your environment:
#   - Development: cp .env.development .env
#   - Production:  cp .env.production .env
# 
# NEVER commit .env to version control

# Required for both environments:
# DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
# API_KEY=your-secure-api-key-min-32-chars
# JWT_SECRET=your-secure-jwt-secret-min-32-chars

# Cashfree Payment Gateway (Sandbox / Production):
# CASHFREE_APP_ID=TEST...
# CASHFREE_SECRET_KEY=cfsk_...
# CASHFREE_ENV=sandbox
# CASHFREE_API_VERSION=2023-08-01
# CASHFREE_WEBHOOK_SECRET=